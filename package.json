{
  "name": "nlogn-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"yarn workspace nlogn-client dev\" \"yarn workspace nlogn-server dev\"",
    "dev:client": "yarn workspace nlogn-client dev",
    "dev:server": "yarn workspace nlogn-server dev",
    "build": "yarn workspace nlogn-client build",
    "start": "yarn workspace nlogn-server start",
    "lint": "yarn workspace nlogn-client lint",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22"
}
